{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    /* Tests reach into src/services, which resolves asset URLs from
       `import.meta.env.BASE_URL`; vite/client is what declares it. */
    "types": ["node", "vite/client"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "vite.config.ts",
    "src/game/**/*.ts",
    "src/services/webrtc.ts",
    "src/services/chips.ts",
    "tests/**/*.ts"
  ]
}
